{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "apps/site/app/icon.svg",
  "worktreeSubmodules": "none",
  "scripts": [
    { "name": "Setup Worktree", "command": "bash scripts/setup-worktree.sh", "icon": "configure", "runOnWorktreeCreate": true, "async": false },
    { "name": "Clean Worktree", "command": "bash scripts/clean-worktree.sh", "icon": "configure", "runOnSettle": true },
    { "name": "Dev", "command": "cd apps/app && npx vite dev --port 4800", "icon": "play", "stopOnSettle": true, "previewUrl": "http://localhost:4800" },
    { "name": "Site Dev", "command": "cd apps/site && npx next dev --port 4810", "icon": "play", "stopOnSettle": true, "previewUrl": "http://localhost:4810" },
    { "name": "Test", "command": "cd apps/app && npx vitest run", "icon": "test" },
    { "name": "Typecheck", "command": "cd apps/app && npx tsc --noEmit", "icon": "lint" }
  ]
}
