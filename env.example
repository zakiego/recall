# Recall configuration template. Copy it to a file named .env next to compose.yaml
# and fill it in. compose.yaml loads that file into the container. Outside Docker the
# server reads only its process environment, so export the values first
# (set -a; . <your env file>; set +a). Every value below is a placeholder.

# --- Required ---------------------------------------------------------------

# Public origin of this instance, no trailing slash and no /app. Used for cookies,
# the passkey relying party and invite links. Sign-in refuses other origins.
RECALL_URL=http://localhost:4800

# 32+ random characters: openssl rand -base64 48
# Signs OAuth hand-offs and encrypts OAuth client secrets. Keep it stable.
SESSION_SECRET=replace-with-48-random-bytes-in-base64

# Any OpenAI-compatible base URL that serves /v1/chat/completions with streaming.
# Extraction, profiles and Ask need it. Search works without it.
GATEWAY_URL=https://llm-gateway.example.com/api
GATEWAY_KEY=replace-with-your-gateway-key

# --- First user -------------------------------------------------------------

# Optional. Read only while the database has no users: creates user "zaki" with this
# password hash. Make one with `recall hash-password`. Or leave it empty and run
# `recall create-user <name> --workspace <slug> --new-workspace` instead.
ADMIN_PASSWORD_HASH=

# --- Models -----------------------------------------------------------------

EXTRACT_MODEL=claude-haiku-5-5
# Used when the gateway rejects EXTRACT_MODEL. Same model by default (no fallback).
FALLBACK_MODEL=claude-haiku-5-5

# --- Optional ---------------------------------------------------------------

# Container used when a request names none.
RECALL_DEFAULT_CONTAINER=default
# Where recall.db and models/ live. /data in the container, ./data otherwise.
# DATA_DIR=/data
# Passkey relying party id. Defaults to the hostname of RECALL_URL.
# PASSKEY_RP_ID=recall.example.com
# "off" turns off the /api/auth rate limit (tests only).
# RECALL_AUTH_RATE_LIMIT=on
# "off" stops the background job loop (no extraction).
# RECALL_JOBS=on
# Embedding model: "child" (a separate process that stops when idle) or "inline".
# RECALL_EMBED=child
# RECALL_EMBED_IDLE_MS=600000

# Gmail connector: a Google OAuth web client with redirect URI
# RECALL_URL/app/connectors/google/callback. Gmail stays off until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters: openssl rand -base64 48. Encrypts stored connector tokens.
CONNECTOR_SECRET=

# Reminder emails through Resend. Both are needed.
RESEND_API_KEY=
RECALL_EMAIL_FROM="Recall <reminders@example.com>"
