{
  "name": "@recall/app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 4800",
    "build": "vite build && vite build --config vite.cli.config.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node -e \"console.error('Migrations are hand-written: add drizzle/NNNN_name.sql, then run db:bundle. db:draft prints the schema as DDL to copy from. See AGENTS.md (Migrations).'); process.exit(1)\"",
    "db:draft": "node -e \"require('node:fs').rmSync('drizzle-draft', { recursive: true, force: true })\" && drizzle-kit generate --name draft",
    "db:bundle": "tsx scripts/bundle-migrations.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "@supermemory/memory-graph": "0.2.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "ai": "7.0.166",
    "better-auth": "1.7.18",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "linkedom": "0.18.15",
    "lucide-react": "1.70.0",
    "nitro": "3.0.261103-rc",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.7.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
