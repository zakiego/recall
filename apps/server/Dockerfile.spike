# syntax=docker/dockerfile:1
# M0 spike image (docs/GO-PORT.md): proves the cgo build with sqlite-vec, FTS5
# and ONNX Runtime loads on Linux and records the image size. Context: apps/server.
FROM golang:1.26.11-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY scripts ./scripts
RUN ./scripts/fetch-onnxruntime.sh "linux-$(go env GOARCH)" /out/lib
COPY internal ./internal
COPY tools ./tools
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=1 go build -tags sqlite_fts5 -trimpath -ldflags "-s -w" -o /out/spike ./tools/spike \
  && CGO_ENABLED=1 go build -tags sqlite_fts5 -trimpath -ldflags "-s -w" -o /out/membench ./tools/membench

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /out/lib/ /usr/lib/recall/
COPY --from=build /out/spike /out/membench /usr/bin/
USER 1000:1000
ENTRYPOINT ["/usr/bin/spike"]
